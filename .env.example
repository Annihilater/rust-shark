HOST=0.0.0.0
PORT=17823
# 直接运行二进制时使用相对路径（必须通过 run.sh 启动以确保工作目录正确）
# Docker Compose 部署时此值被 docker-compose.yml 里的绝对路径覆盖，无需修改
DATABASE_URL=sqlite://data/rust-shark.db
SECRET_KEY=change-me-in-production-must-be-32-chars!!
JWT_SECRET=change-jwt-secret-in-production-must-be-32!
JWT_EXPIRY_HOURS=24
DATA_DIR=data
RUST_LOG=info

# ─── 管理员账号 ─────────────────────────────────────────────────────────────────
# 服务启动时自动检查：若数据库中不存在则创建，若密码与此处不一致则重置为此处的值。
# 修改密码后重启服务即生效，无需手动操作数据库。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Administrator
